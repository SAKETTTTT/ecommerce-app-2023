# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

PORT=5000
DEV_MODE=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URL=mongodb://127.0.0.1:27017/ecommerce

# Any long random string, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Braintree SANDBOX credentials (https://developer.paypal.com/braintree/docs/start/overview)
BRAINTREE_MERCHANT_ID=your-merchant-id
BRAINTREE_PUBLIC_KEY=your-public-key
BRAINTREE_PRIVATE_KEY=your-private-key
